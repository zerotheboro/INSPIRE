{
  "name": "inspire-vietnamese-wellness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm --prefix functions run build && node --import ./tests/register-ts.mjs --test tests/inspire-chat.test.mjs",
    "test:browser": "node tests/inspire-browser.mjs",
    "emulators": "node tests/start-inspire-emulators.mjs",
    "test:emulators": "node --import ./tests/register-ts.mjs --test tests/inspire-emulator.test.mjs",
    "knowledge:import": "node --import ./tests/register-ts.mjs tests/import-inspire-knowledge.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.18.0",
    "html-to-image": "^1.11.13",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^8.4.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "firebase-tools": "^15.35.0",
    "gh-pages": "^6.3.0"
  }
}
