+export function decodeChatgptTurn(prepared: Prepared, threadId: string,
+  turnId: string, events: unknown[]) {
+  if (!threadId || !turnId || events.length !== 1) {
+    throw Error("CHATGPT_PROTOCOL_HOLD");
+  }
+  const event = events[0];
