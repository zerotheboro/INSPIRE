+  try{const bytes=read(file.path);if(hash(bytes)!==file.sha256||bytes.length!==file.bytes)mismatches.push(file.path)}catch{mismatches.push(file.path)}
+}
+const corpus=JSON.parse(read('sources/verified_corpus_032.json'))
