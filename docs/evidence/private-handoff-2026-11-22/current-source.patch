@@ -0,0 +1,42 @@
+"""Read-only exact passage candidates, not a source-use or policy approval."""
+import json
+import re
+import hashlib
+from pathlib import Path
+
+root = Path(".private.local/controller040-preview/INSPIRE_AI_040")
+corpus = json.loads((root / "sources/verified_corpus_032.json").read_text(encoding="utf-8"))
+current = json.loads((root / "manifests/SOURCE_VERSION_MANIFEST_040.json").read_text(encoding="utf-8"))
+selection = [
+    ("sources/recovered_20261104/INSPIRE-MOI-01_v1.0.txt",
+     ["XCII", "XCIII", "CLVI", "CLVII", "CLIX", "CLXIII"], "proposed-operating-rules", "Native Controller system context; Proposal/Pending Review retained."),
+    ("sources/recovered/INSPIRE-02.txt", ["4", "6", "93"],
+     "proposed-reference-only", "Distinguish reported experience from interpretation, and preserve user corrections."),
+    ("sources/recovered/INSPIRE-01.txt", ["33", "34"],
+     "review-rationale-only-not-in-trial-input", "Keep reference knowledge, operating rules and intervention rights separate."),
+]
+records = []
+for path, sections, use, rationale in selection:
+    raw = (root / path).read_bytes()
+    source = next(r for r in corpus["source_records"] if r["path"] == path)
+    assert hashlib.sha256(raw).hexdigest() == source["sha256"]
+    text = raw.decode("utf-8-sig")  # Preserve original line endings in selected-byte hashes.
+    for number in sections:
+        match = re.search(r"^# " + re.escape(number) + r"\..*?(?=^# |\Z)", text, re.M | re.S)
+        assert match, (path, number)
+        passage = match.group().encode("utf-8")
+        records.append({"document_id": source["document_id"], "declared_version": source["declared_version"],
+                        "source_path": path, "source_sha256": source["sha256"], "section": number,
+                        "heading": match.group().splitlines()[0], "section_bytes": len(passage),
+                        "section_sha256": hashlib.sha256(passage).hexdigest(),
+                        "source_status": source["source_status"], "approval_status": source["approval_status"],
+                        "runtime_manifest_declared_status": current["runtime_source_context"]["declared_status"]
+                        if path == "sources/recovered_20261104/INSPIRE-MOI-01_v1.0.txt" else None,
+                        "proposed_use": use, "rationale": rationale, "trial_export_approved": False,
+                        "permission_needed": "Owner/source-authority decision bound to version, exact section hash, purpose, provider, duration and limits; operating-rule adoption is separate from reference-use consent and intervention permission."})
+output = {"executed": True, "read_only": True, "selection_is_approval": False,
+          "private_passage_text_excluded": True, "candidate_sections": records,
+          "excluded": ["All other corpus passages unless independently scoped and approved", "Content patches", "458 draft lessons", "Reconstructed or historical MOI-01-A", "Intervention instructions"]}
+Path("docs/evidence/generative-preparation/source-candidates.json").write_text(
+    json.dumps(output, ensure_ascii=False, indent=2), encoding="utf-8")
+print(f"Verified {len(records)} exact section candidates; ZERO export/runtime approvals created.")
diff --git a/tests/package-inspire-luna-review.py b/tests/package-inspire-luna-review.py
new file mode 100644
index 0000000..53e0403
--- /dev/null
+++ b/tests/package-inspire-luna-review.py
@@ -0,0 +1,189 @@
+"""Local review archive only. No deployment, credential access or model call."""
+import sys
+sys.dont_write_bytecode = True
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "docs/evidence/luna-api-2026-11-14"
+CHECKPOINT = Path(os.environ["TEMP"]) / "INSPIRE-before-luna-api-2026-11-14"
+ARCHIVE = ROOT / "INSPIRE-review-luna-api-2026-11-14.zip"
+if json.loads((ROOT / "package.json").read_text())["name"] != "inspire-vietnamese-wellness":
+    raise RuntimeError("INSPIRE workspace required")
+OUT.mkdir(parents=True, exist_ok=True)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def save(name, value):
+    (OUT / name).write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+before = json.loads((CHECKPOINT / "manifest.json").read_text())
+listed = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=ROOT).decode().split("\0")
+generated = {"tsconfig.app.tsbuildinfo", "tsconfig.node.tsbuildinfo"}
+evidence = "docs/evidence/luna-api-2026-11-14/"
+needed_metadata = {
+    "docs/evidence/research-trial-plan-2026-11-10/owner-decision-matrix.json",
+    "docs/evidence/research-trial-plan-2026-11-10/outbound-template-proposal.json",
+}
+
+
+def eligible(name):
+    p = Path(name)
+    if not name or not (ROOT / p).is_file():
+        return False
+    if any(part in {".git", "node_modules", ".private.local", ".tools.local", "__pycache__", "dist", "lib"} for part in p.parts):
+        return False
+    if p.name.startswith(".env") or p.name in {"api-key.txt", "authorization.json", "first-attempt.json"}:
+        return False
+    if p.suffix.lower() in {".zip", ".db", ".sqlite", ".sqlite3", ".pyc", ".pyo", ".log", ".pem", ".key", ".pfx", ".tsbuildinfo"}:
+        return False
+    if name.startswith("docs/evidence/"):
+        if name in needed_metadata:
+            return True
+        if not name.startswith(evidence):
+            return False
+        if p.name in {"focused-milestone.patch", "package-verification.json", "archive-manifest.json"}:
+            return False
+        if p.name.endswith("-legacy-trace.json") or p.name in {"consolidation-offline-trace.json", "research-adapter-input-trace.json"}:
+            return False
+    return True
+
+
+files = sorted(set(name for name in listed if eligible(name)))
+changed = [name for name in files if not name.startswith("docs/evidence/") and
+           (name not in before or sha((ROOT / name).read_bytes()) != before[name])]
+old_changed = [name for name in before if (ROOT / name).is_file() and sha((ROOT / name).read_bytes()) != before[name]]
+unexpected = [name for name in old_changed if name not in changed and name not in generated]
+if unexpected:
+    raise RuntimeError("Unexpected earlier-file changes: " + ", ".join(unexpected))
+missing = [name for name in before if not (ROOT / name).exists()]
+if missing:
+    raise RuntimeError("Earlier files missing: " + ", ".join(missing))
