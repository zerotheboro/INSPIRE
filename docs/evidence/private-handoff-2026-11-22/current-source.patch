diff --git a/functions/src/inspireAccount.ts b/functions/src/inspireAccount.ts
new file mode 100644
index 0000000..f17fbe0
--- /dev/null
+++ b/functions/src/inspireAccount.ts
@@ -0,0 +1,324 @@
+import {getAuth} from "firebase-admin/auth";
+import {getFirestore, Timestamp} from "firebase-admin/firestore";
+import {createHash} from "node:crypto";
+import {ChatError, exactKeys, record} from "./inspireChatContract";
+import type {ChatRequest} from "./inspireChatContract";
+
+export type Identity = {
+  uid: string; registered: boolean; providers: string[];
+  email: string | null; createdAt: string;
+};
+export type Preferences = {
+  name: string; address: string; language: string; ageRange: string;
+  context: string; desiredSupport: string;
+};
+export const emptyPreferences: Preferences = {
+  name: "", address: "", language: "", ageRange: "",
+  context: "", desiredSupport: "",
+};
+
+/**
+ * Compute the Vietnam calendar month without a browser clock or reset job.
+ * @param {number} time Server milliseconds since epoch.
+ * @return {object} Month key and next midnight reset in UTC.
+ */
+export function vietnamMonth(time: number) {
+  const date = new Date(time + 7 * 3600000);
+  const year = date.getUTCFullYear(); const month = date.getUTCMonth();
+  return {
+    key: `${year}-${String(month + 1).padStart(2, "0")}`,
+    nextReset: new Date(Date.UTC(year, month + 1, 1) - 7 * 3600000)
+      .toISOString(),
+  };
+}
+
+/**
+ * Derive identity from verified Auth records, never payload flags.
+ * @param {string} token Firebase ID token.
+ * @return {Promise<Identity>} Current verified account metadata.
+ */
+export async function verifiedIdentity(token: string): Promise<Identity> {
+  try {
+    const claims = await getAuth().verifyIdToken(token, true);
+    const user = await getAuth().getUser(claims.uid);
+    if (user.disabled) throw Error("disabled");
+    const providers = user.providerData.map((provider) => provider.providerId);
+    return {
+      uid: user.uid, registered: providers.length > 0,
+      providers, email: user.email ?? null,
+      createdAt: user.metadata.creationTime,
+    };
+  } catch {
+    throw new ChatError("UNAUTHENTICATED",
+      "Vui lòng kết nối lại hoặc đăng nhập để tiếp tục.", "none", 401);
+  }
+}
+
+/**
+ * Allow only optional, user-stated profile fields.
+ * @param {unknown} value Untrusted preferences object.
+ */
+export function validatePreferences(
+  value: unknown,
+): asserts value is Preferences {
+  if (!record(value)) {
+    throw new ChatError("PROFILE", "Thông tin tùy chọn không hợp lệ.");
+  }
+  exactKeys(value, Object.keys(emptyPreferences));
+  for (const key of Object.keys(emptyPreferences)) {
+    const limit = key === "context" || key === "desiredSupport" ? 1000 : 100;
+    if (typeof value[key] !== "string" ||
+        (value[key] as string).length > limit) {
+      throw new ChatError("PROFILE",
+        "Thông tin tùy chọn quá dài hoặc không hợp lệ.");
+    }
+  }
+  if (!["", "under18", "18-29", "30-44", "45-59", "60+"]
+    .includes(value.ageRange as string)) {
+    throw new ChatError("PROFILE", "Khoảng tuổi không hợp lệ.");
+  }
+}
+
+/** Server-owned account metadata and atomic completed-reply accounting. */
+export class AccountService {
+  /** Construct with an injectable server clock. */
+  constructor(private now: () => number = Date.now) {}
+
+  /**
+   * Select the bucket from verified registration status.
+   * @param {Identity} identity Verified caller.
+   * @return {string} Lifetime guest or Vietnam month key.
+   */
+  private period(identity: Identity) {
+    return identity.registered ? vietnamMonth(this.now()).key : "guest";
+  }
+
+  /**
+   * Construct server-only references without client-supplied paths.
+   * @param {Identity} identity Verified caller.
+   * @param {string} operationId Opaque operation reference.
+   * @return {object} Account, alias, period and operation references.
+   */
+  private refs(identity: Identity, operationId?: string) {
+    const db = getFirestore(); const period = this.period(identity);
+    const account = db.collection("inspireAccounts").doc(identity.uid);
+    const operationKey = createHash("sha256")
+      .update(identity.uid + ":" + operationId).digest("hex");
+    return {
+      account,
+      alias: db.collection("inspireIdentityLinks").doc(identity.uid),
+      usage: account.collection("usage").doc(period),
+      pendingState: account.collection("quotaState").doc("registered"),
+      operation: db.collection("inspireOperations").doc(operationKey),
+      period,
+    };
+  }
+
+  /**
+   * Return only the verified owner's account, quota and optional preferences.
+   * @param {Identity} identity Verified caller.
+   * @return {Promise<object>} Account view with server-computed allowance.
+   */
+  async account(identity: Identity) {
+    const refs = this.refs(identity); const db = getFirestore();
+    await db.runTransaction(async (tx) => {
+      const alias = await tx.get(refs.alias);
+      if (alias.exists && !identity.registered) {
+        throw new ChatError("ACCOUNT_LINKED",
+          "Danh tính khách này đã liên kết tài khoản. Vui lòng đăng nhập.",
+          "none", 403);
+      }
+      tx.set(refs.account, {
+        uid: identity.uid, registered: identity.registered,
+        providers: identity.providers, email: identity.email,
+        authCreatedAt: identity.createdAt,
+        updatedAt: Timestamp.fromMillis(this.now()),
+      }, {merge: true});
+    });
+    const [usage, preferences, pendingState] = await Promise.all([
+      refs.usage.get(),
+      db.collection("inspirePreferences").doc(identity.uid).get(),
+      refs.pendingState.get(),
+    ]);
+    const completed = usage.data()?.completed ?? 0;
+    const reserved = identity.registered ?
+      pendingState.data()?.pending ?? 0 : usage.data()?.reserved ?? 0;
+    const limit = identity.registered ? 30 : 10;
+    return {
+      uid: identity.uid, registered: identity.registered, email: identity.email,
+      providers: identity.providers,
+      quota: {
+        limit, completed, pending: reserved,
+        remaining: Math.max(0, limit - completed - reserved),
+        period: refs.period,
+        nextReset: identity.registered ?
+          vietnamMonth(this.now()).nextReset : null,
+      },
+      preferences: preferences.exists ?
+        preferences.data() as Preferences : {...emptyPreferences},
+    };
+  }
+
+  /**
+   * Save only the authenticated owner's allowlisted preferences.
+   * @param {Identity} identity Verified caller.
+   * @param {unknown} value Untrusted optional fields.
+   * @return {Promise<Preferences>} Validated user-stated fields.
+   */
+  async savePreferences(identity: Identity, value: unknown) {
+    validatePreferences(value);
+    await getFirestore().collection("inspirePreferences")
+      .doc(identity.uid).set(value);
+    return value;
+  }
+
+  /**
+   * Link a guest using proof of both identities without transferring balance.
+   * @param {Identity} current Verified registered caller.
+   * @param {string} previousToken Previous guest's ID token.
+   */
+  async linkGuest(current: Identity, previousToken: string) {
+    if (!current.registered) {
+      throw new ChatError("LINK",
+        "Cần đăng nhập tài khoản để liên kết.", "none", 403);
+    }
+    const old = await verifiedIdentity(previousToken);
+    if (old.uid === current.uid) return;
+    if (old.registered) {
+      throw new ChatError("LINK",
+        "Không thể gộp hai tài khoản đã đăng ký.", "none", 403);
+    }
+    const ref = getFirestore().collection("inspireIdentityLinks").doc(old.uid);
+    await getFirestore().runTransaction(async (tx) => {
+      const prior = await tx.get(ref);
+      if (prior.exists && prior.data()?.linkedTo !== current.uid) {
+        throw new ChatError("LINK",
+          "Danh tính đã liên kết với tài khoản khác.", "none", 409);
+      }
+      tx.set(ref, {
+        linkedTo: current.uid, linkedAt: Timestamp.fromMillis(this.now()),
+      });
+    });
+  }
+
+  /**
+   * Atomically reserve capacity and reject previously recorded operations.
+   * @param {Identity} identity Verified caller.
+   * @param {ChatRequest} request Validated request.
+   */
+  async reserve(identity: Identity, request: ChatRequest) {
+    const refs = this.refs(identity, request.operationId);
+    const db = getFirestore();
+    const fingerprint = createHash("sha256")
+      .update(JSON.stringify(request)).digest("hex");
+    await db.runTransaction(async (tx) => {
+      const [operation, usage, alias, state] = await Promise.all([
+        tx.get(refs.operation), tx.get(refs.usage),
+        tx.get(refs.alias), tx.get(refs.pendingState),
+      ]);
+      if (alias.exists && !identity.registered) {
+        throw new ChatError("ACCOUNT_LINKED",
+          "Vui lòng đăng nhập tài khoản đã liên kết.", "none", 403);
+      }
+      if (operation.exists) {
+        const previous = operation.data()!;
+        if (previous.fingerprint !== fingerprint) {
+          throw new ChatError("OPERATION_CONFLICT",
+            "Mã lượt gửi đã được dùng cho nội dung khác.", "none", 409);
+        }
+        throw new ChatError("RESULT_UNAVAILABLE",
+          "Lượt gửi đã được ghi nhận nhưng kết quả không còn " +
+          "trong phiên này. " +
+          "Không tự chạy lại hoặc tính thêm lượt.", "none", 409);
+      }
+      const completed = usage.data()?.completed ?? 0;
+      const reserved = usage.data()?.reserved ?? 0;
+      const pending = identity.registered ?
+        state.data()?.pending ?? 0 : reserved;
+      if (completed + pending >= (identity.registered ? 30 : 10)) {
+        const message = identity.registered ?
+          "Bạn đã dùng hết lượt phản hồi của tháng này, " +
+          "hoặc có lượt đang chờ xác minh." :
+          "Bạn đã dùng hết 10 lượt khách, hoặc có lượt đang chờ xác minh. " +
+          "Đăng nhập để dùng hạn mức tài khoản.";
+        throw new ChatError("QUOTA_EXHAUSTED", message, "new-attempt", 429);
+      }
+      tx.set(refs.usage, {
+        completed, reserved: reserved + 1, period: refs.period,
+      });
+      if (identity.registered) {
+        tx.set(refs.pendingState, {pending: pending + 1});
+      }
+      tx.create(refs.operation, {
+        uid: identity.uid, period: refs.period, fingerprint,
+        epoch: request.epoch, status: "pending",
+        createdAt: Timestamp.fromMillis(this.now()),
+      });
+    });
+  }
+
+  /**
+   * Idempotently settle a trusted outcome, retaining unknown reservations.
+   * @param {Identity} identity Verified operation owner.
+   * @param {string} operationId Opaque operation reference.
+   * @param {string} outcome Trusted completion/failure or unknown state.
+   */
+  async settle(
+    identity: Identity, operationId: string,
+    outcome: "completed" | "failed" | "unknown",
+  ) {
+    const {operation} = this.refs(identity, operationId);
+    const db = getFirestore();
+    await db.runTransaction(async (tx) => {
+      const snap = await tx.get(operation);
+      if (!snap.exists || snap.data()?.uid !== identity.uid) {
+        throw new ChatError("OPERATION",
+          "Không xác minh được lượt gửi.", "none", 409);
+      }
+      const data = snap.data()!;
+      if (["completed", "failed"].includes(data.status)) {
+        if (data.status !== outcome) {
+          throw new ChatError("RECONCILIATION",
+            "Kết quả cần được xác minh riêng.", "none", 409);
+        }
+        return;
+      }
+      const account = db.collection("inspireAccounts").doc(identity.uid);
+      const usage = account.collection("usage").doc(data.period);
+      const stored = await tx.get(usage);
+      const completed = stored.data()?.completed ?? 0;
+      const reserved = stored.data()?.reserved ?? 0;
+      const registered = data.period !== "guest";
+      const chargedPeriod = registered ? vietnamMonth(this.now()).key : "guest";
+      const chargedUsage = account.collection("usage").doc(chargedPeriod);
+      const charged = chargedPeriod === data.period ?
+        stored : await tx.get(chargedUsage);
+      const pendingRef = account.collection("quotaState").doc("registered");
+      const state = registered ? await tx.get(pendingRef) : undefined;
+      tx.update(operation, {
+        status: outcome, updatedAt: Timestamp.fromMillis(this.now()),
+        ...(outcome === "completed" ? {chargedPeriod} : {}),
+      });
+      if (outcome !== "unknown") {
+        tx.set(usage, {
+          period: data.period,
+          completed: completed +
+            (outcome === "completed" && chargedPeriod === data.period ? 1 : 0),
+          reserved: Math.max(0, reserved - 1),
+        });
+        if (outcome === "completed" && chargedPeriod !== data.period) {
+          tx.set(chargedUsage, {
+            period: chargedPeriod,
+            completed: (charged.data()?.completed ?? 0) + 1,
+            reserved: charged.data()?.reserved ?? 0,
+          });
+        }
+        if (registered) {
+          tx.set(pendingRef, {
+            pending: Math.max(0, (state?.data()?.pending ?? 0) - 1),
+          });
+        }
+      }
+    });
+  }
+}
diff --git a/functions/src/inspireChatContract.ts b/functions/src/inspireChatContract.ts
new file mode 100644
index 0000000..d837439
--- /dev/null
+++ b/functions/src/inspireChatContract.ts
@@ -0,0 +1,174 @@
+// Shared wire contract. Conversation text is data, never system instructions.
+export const CHAT_LIMITS = {
+  message: 2000, messages: 31, context: 24000,
+} as const;
+
+export type ChatMessage = {
+  id: string;
+  role: "user" | "assistant";
+  text: string;
+  correctionOf?: string;
+};
+export type ChatRequest = {
+  kind: "send" | "replay";
+  epoch: string;
+  sessionId: string;
+  operationId: string;
+  conversationId: string;
+  messages: ChatMessage[];
+};
+export type ChatMode = "simulation" | "private-model";
+export type ChatResponse = {
+  mode: ChatMode;
+  epoch: string;
+  sessionId: string;
+  operationId: string;
+  conversationId: string;
+  replyTo: string;
+  message: ChatMessage;
+};
+export type RetryKind = "replay" | "new-attempt" | "none";
+/** A display-safe failure, separate from assistant conversation text. */
+export class ChatError extends Error {
+  /**
+   * Construct a failure with a machine-readable retry policy.
+   * @param {string} message Display-safe Vietnamese explanation.
+   */
+  constructor(
+    public code: string,
+    message: string,
+    public retry: RetryKind = "none",
+    public status = 400,
+  ) {
+    super(message);
+  }
+}
+
+/**
+ * Narrow a JSON object without accepting null or arrays.
+ * @param {unknown} value Untrusted value.
+ * @return {boolean} Whether the value is an object.
+ */
+export function record(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === "object" && !Array.isArray(value);
+}
+/**
+ * Reject all unsupported fields, including client authority metadata.
+ * @param {object} value Untrusted object.
+ * @param {string[]} keys Allowed field names.
+ */
+export function exactKeys(value: Record<string, unknown>, keys: string[]) {
+  if (Object.keys(value).some((key) => !keys.includes(key))) {
+    throw new ChatError("INVALID_REQUEST",
+      "Yêu cầu chứa trường không được hỗ trợ.");
+  }
+}
+/**
+ * IDs are opaque references and never confer permissions.
+ * @param {unknown} value Untrusted reference.
+ * @return {boolean} Whether the reference has valid syntax.
+ */
+function identifier(value: unknown): value is string {
+  return typeof value === "string" && /^[a-zA-Z0-9_-]{1,80}$/.test(value);
+}
+/**
+ * Validate complete ordered history; never shorten or rewrite client text.
+ * @param {unknown} value Full untrusted history.
+ */
+export function validateMessages(
+  value: unknown,
+): asserts value is ChatMessage[] {
+  if (!Array.isArray(value) || !value.length ||
+      value.length > CHAT_LIMITS.messages) {
+    throw new ChatError("CONTEXT_LIMIT",
+      "Cuộc trò chuyện đã đạt giới hạn. Hãy mở cuộc trò chuyện mới.");
+  }
+  const seen = new Map<string, ChatMessage>();
+  let length = 0;
+  value.forEach((item, index) => {
+    if (!record(item)) {
+      throw new ChatError("INVALID_REQUEST", "Tin nhắn không hợp lệ.");
+    }
+    exactKeys(item, ["id", "role", "text", "correctionOf"]);
+    if (!identifier(item.id) || seen.has(item.id) ||
+        item.role !== (index % 2 === 0 ? "user" : "assistant") ||
+        typeof item.text !== "string" || !item.text.trim() ||
+        item.text.length > CHAT_LIMITS.message) {
+      throw new ChatError("INVALID_REQUEST",
+        "Vai trò, thứ tự hoặc nội dung tin nhắn không hợp lệ " +
+        "(tối đa 2.000 ký tự).");
+    }
+    if ("correctionOf" in item &&
+        (item.role !== "user" || !identifier(item.correctionOf) ||
+        seen.get(item.correctionOf)?.role !== "user")) {
+      throw new ChatError("INVALID_CORRECTION",
+        "Chỉ có thể đính chính một tin nhắn của bạn đã gửi trước đó.");
+    }
+    length += item.text.length;
+    seen.set(item.id, item as ChatMessage);
+  });
+  if (value.length % 2 !== 1) {
+    throw new ChatError("INVALID_REQUEST", "Thiếu tin nhắn cần phản hồi.");
+  }
+  if (length > CHAT_LIMITS.context) {
+    throw new ChatError("CONTEXT_LIMIT",
+      "Nội dung đã vượt giới hạn của bản thử nghiệm. " +
+      "Hãy mở cuộc trò chuyện mới.");
+  }
+}
+/**
+ * Enforce the allowlisted request contract before any adapter runs.
+ * @param {unknown} value Untrusted request envelope.
+ */
+export function validateRequest(value: unknown): asserts value is ChatRequest {
+  if (!record(value)) {
+    throw new ChatError("INVALID_REQUEST", "Yêu cầu không hợp lệ.");
+  }
+  exactKeys(value, ["kind", "epoch", "sessionId", "operationId",
+    "conversationId", "messages"]);
+  if ((value.kind !== "send" && value.kind !== "replay") ||
+      ![value.epoch, value.sessionId, value.operationId,
+        value.conversationId].every(identifier)) {
+    throw new ChatError("INVALID_REQUEST", "Thông tin lượt gửi không hợp lệ.");
+  }
+  validateMessages(value.messages);
+}
+/**
+ * Bind output to the exact session, operation, conversation and user turn.
+ * @param {unknown} value Untrusted adapter or transport output.
+ * @param {ChatRequest} request Original request.
+ * @param {string} mode Exact server-issued transport mode.
+ * @return {void} Throw on any mismatch.
+ */
+export function validateResponse(
+  value: unknown, request: ChatRequest, mode: ChatMode = "simulation",
+): asserts value is ChatResponse {
+  const fail = () => {
+    throw new ChatError("INVALID_RESPONSE",
+      "Không xác minh được phản hồi cho lượt gửi này.", "replay", 502);
+  };
+  if (!record(value)) return fail();
+  try {
+    exactKeys(value, ["mode", "epoch", "sessionId", "operationId",
+      "conversationId", "replyTo", "message"]);
+  } catch {
+    return fail();
+  }
+  if (value.mode !== mode || value.epoch !== request.epoch ||
+      value.sessionId !== request.sessionId ||
+      value.operationId !== request.operationId ||
+      value.conversationId !== request.conversationId ||
+      value.replyTo !== request.messages[request.messages.length - 1]?.id ||
+      !record(value.message)) return fail();
+  const message = value.message;
+  try {
+    exactKeys(message, ["id", "role", "text"]);
+  } catch {
+    return fail();
+  }
+  if (!identifier(message.id) ||
+      request.messages.some((m) => m.id === message.id) ||
+      message.role !== "assistant" || typeof message.text !== "string" ||
+      !message.text.trim() ||
+      message.text.length > CHAT_LIMITS.message) return fail();
+}
diff --git a/functions/src/inspireChatSimulation.ts b/functions/src/inspireChatSimulation.ts
new file mode 100644
index 0000000..446a47c
--- /dev/null
+++ b/functions/src/inspireChatSimulation.ts
@@ -0,0 +1,192 @@
+import {randomUUID} from "node:crypto";
+import {
+  ChatError, validateRequest, validateResponse,
+} from "./inspireChatContract";
+import type {
+  ChatMessage, ChatRequest, ChatResponse, ChatMode,
+} from "./inspireChatContract";
+
+type Session = {
+  touched: number; owner?: string; conversations: Map<string, ChatMessage[]>;
+};
+type Operation = { fingerprint: string; result: Promise<ChatResponse> };
+type Generator = (
+  messages: readonly ChatMessage[], request?: ChatRequest
+) => Promise<string>;
+export type OperationHooks = {
+  reserve(): Promise<void>;
+  complete(response: ChatResponse): Promise<void>;
+  fail(error: unknown, outputValidated: boolean): Promise<never>;
+};
+
+/**
+ * Quote an explicit excerpt, preserving full history in the request.
+ * @param {string} text Original text.
+ * @param {number} length Display excerpt length.
+ * @return {string} Quotation with an ellipsis if shortened.
+ */
+function excerpt(text: string, length: number): string {
+  return text.length > length ? text.slice(0, length) + "…" : text;
+}
+
+// Mechanical demonstration; no fixtures, test answers or model calls.
+export const simulateConversation: Generator = async (messages) => {
+  const latest = messages[messages.length - 1];
+  const users = messages.filter((m) => m.role === "user");
+  if (latest.correctionOf) {
+    const original = messages.find((m) => m.id === latest.correctionOf)!;
+    return "Mình đã ghi nhận đính chính của bạn: “" +
+      excerpt(latest.text, 380) + "”. Tin nhắn gốc “" +
+      excerpt(original.text, 300) + "” vẫn được giữ để bạn có thể xem lại." +
+      "\n\nĐây là phản hồi mô phỏng, chưa phải phản hồi từ mô hình AI.";
+  }
+  const context = users.length > 1 ?
+    `Cuộc trò chuyện hiện có ${users.length} tin nhắn của bạn ` +
+    "cùng các phản hồi trước đó, theo đúng thứ tự. " +
+    "Bạn có thể tiếp tục ý vừa nói hoặc đính chính một tin nhắn cũ." :
+    "Bạn có thể tiếp tục bằng một ý khác, một câu hỏi " +
+    "hoặc điều bạn muốn làm rõ.";
+  return "Mình đã nhận được: “" + excerpt(latest.text, 480) + "”.\n\n" +
+    context + "\n\nĐây là phản hồi mô phỏng để trải nghiệm cách trò chuyện, " +
+    "chưa phải phản hồi từ mô hình AI.";
+};
+
+/**
+ * Create one bounded, process-local simulation with a unique restart epoch.
+ * @param {Generator} generate Offline adapter, injectable for failure tests.
+ * @param {function(): number} now Clock, injectable for expiry tests.
+ * @param {string} mode Private evaluation mode requires separate admission.
+ * @return {object} Session issuer and validated operation handler.
+ */
+export function createSimulationServer(
+  generate: Generator = simulateConversation,
+  now: () => number = Date.now,
+  mode: ChatMode = "simulation",
+) {
+  const epoch = randomUUID();
+  const sessions = new Map<string, Session>();
+  const operations = new Map<string, Operation>();
+  const busy = new Set<string>();
+  const lifetime = 30 * 60 * 1000;
+  /**
+   * Issue an unpredictable reference with no client identity claims.
+   * @param {string} owner Verified identity bound to this session.
+   * @return {object} Simulation session and process epoch.
+   */
+  function session(owner?: string) {
+    // Never evict an unresolved operation. Expired session replays fail closed.
+    for (const [id, value] of sessions) {
+      if (now() - value.touched > lifetime &&
+          ![...busy].some((key) => key.startsWith(id + ":"))) {
+        sessions.delete(id);
+        for (const key of operations.keys()) {
+          if (key.startsWith(id + ":")) operations.delete(key);
+        }
+      }
+    }
+    if (sessions.size >= 100) {
+      throw new ChatError("CAPACITY",
+        "Bản thử nghiệm đang bận. Vui lòng thử lại sau.", "none", 503);
+    }
+    const sessionId = randomUUID();
+    sessions.set(sessionId, {touched: now(), owner, conversations: new Map()});
+    return {epoch, sessionId, mode};
+  }
+  /**
+   * Validate and replay exactly once within this process and session.
+   * @param {unknown} input Untrusted wire request.
+   * @param {string} owner Current verified caller.
+   * @param {OperationHooks} hooks Durable reservation/completion callbacks.
+   */
+  async function handle(
+    input: unknown, owner?: string, hooks?: OperationHooks,
+  ): Promise<ChatResponse> {
+    validateRequest(input);
+    const request: ChatRequest = input;
+    if (request.epoch !== epoch) {
+      throw new ChatError("SESSION_LOST",
+        "Máy chủ đã khởi động lại. Không thể xác định kết quả lượt trước; " +
+        "hãy mở cuộc trò chuyện mới.", "none", 409);
+    }
+    const current = sessions.get(request.sessionId);
+    if (current && current.owner !== owner) {
+      throw new ChatError("IDENTITY_CHANGED",
+        "Tài khoản đã thay đổi. Hãy mở cuộc trò chuyện mới.", "none", 403);
+    }
+    if (!current || now() - current.touched > lifetime) {
+      throw new ChatError("SESSION_LOST",
+        "Phiên thử nghiệm đã hết hạn. Hãy mở cuộc trò chuyện mới.",
+        "none", 409);
+    }
+    current.touched = now();
+    const key = request.sessionId + ":" + request.operationId;
+    const conversationKey = request.sessionId + ":" + request.conversationId;
+    const fingerprint = JSON.stringify([
+      request.conversationId, request.messages,
+    ]);
+    const existing = operations.get(key);
+    if (existing) {
+      if (existing.fingerprint !== fingerprint) {
+        throw new ChatError("OPERATION_CONFLICT",
+          "Lượt gửi không khớp với nội dung ban đầu.", "none", 409);
+      }
+      return existing.result;
+    }
+    if (request.kind === "replay") {
+      throw new ChatError("RESULT_UNKNOWN",
+        "Không còn kết quả để xác minh. Lượt gửi này sẽ không tự chạy lại; " +
+        "hãy mở cuộc trò chuyện mới.", "none", 409);
+    }
+    if (busy.has(conversationKey)) {
+      throw new ChatError("BUSY",
+        "Cuộc trò chuyện đang xử lý một lượt gửi.", "none", 409);
+    }
+    const history = current.conversations.get(request.conversationId) ?? [];
+    if (JSON.stringify(request.messages.slice(0, -1)) !==
+        JSON.stringify(history)) {
+      throw new ChatError("HISTORY_MISMATCH",
+        "Lịch sử không khớp với các lượt đã được xác nhận.", "none", 409);
+    }
+    if (operations.size >= 1000 ||
+        (!history.length && current.conversations.size >= 20)) {
+      throw new ChatError("CAPACITY",
+        "Bản thử nghiệm đã đạt giới hạn bộ nhớ. " +
+        "Hãy khởi động lại máy chủ thử nghiệm.", "none", 503);
+    }
+    busy.add(conversationKey);
+    const result = Promise.resolve().then(async () => {
+      let reserved = false;
+      let outputValidated = false;
+      try {
+        await hooks?.reserve();
+        reserved = true;
+        const text = await generate(structuredClone(request.messages), request);
+        const response: ChatResponse = {
+          mode, epoch, sessionId: request.sessionId,
+          operationId: request.operationId,
+          conversationId: request.conversationId,
+          replyTo: request.messages[request.messages.length - 1].id,
+          message: {id: randomUUID(), role: "assistant", text},
+        };
+        validateResponse(response, request, mode);
+        outputValidated = true;
+        await hooks?.complete(response);
+        current.conversations.set(request.conversationId,
+          [...request.messages, response.message]);
+        return response;
+      } catch (error) {
+        if (!reserved) throw error;
+        if (hooks) return hooks.fail(error, outputValidated);
+        throw new ChatError("ATTEMPT_FAILED",
+          "Lượt xử lý chưa tạo được phản hồi. " +
+          "Bạn có thể bắt đầu một lần thử mới cho cùng tin nhắn.",
+          "new-attempt", 503);
+      } finally {
+        busy.delete(conversationKey);
+      }
+    });
+    operations.set(key, {fingerprint, result});
+    return result;
+  }
+  return {session, handle};
+}
